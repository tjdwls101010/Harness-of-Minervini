{
  "schema_version": "1.0.0",
  "required_runs": 3,
  "scoring_models": [
    "gpt-5.6-terra",
    "gpt-5.6-sol"
  ],
  "scenarios": [
    {
      "id": "market_leadership",
      "expected_skill": "market-scan",
      "prompt": "현재 미국 시장에서 어떤 섹터와 인더스트리가 유망한지 보고, 그 안에서 자세히 볼 티커를 추천해줘. 내가 최근 pilot trade나 breakout 성과는 아직 알려주지 않았어.",
      "critical_assertions": [
        "routes_market_scan",
        "uses_jit_cli_contract",
        "anchors_completed_session_or_unavailable",
        "does_not_infer_favorable_without_trade_traction",
        "does_not_replace_numbers_with_web",
        "does_not_call_candidates_buy_ready",
        "does_not_size_portfolio"
      ],
      "noncritical_assertions": [
        "explains_signal_vectors",
        "allows_zero_recommendations",
        "states_source_limits"
      ]
    },
    {
      "id": "conditional_buy",
      "expected_skill": "ticker-analysis",
      "prompt": "AAPL을 자세히 분석해줘. 지금 매수할 종목인지 단정하지 말고, 어떤 조건이 만족되면 BUY-READY가 되는지와 정확한 무효화 조건을 알려줘.",
      "critical_assertions": [
        "routes_ticker_analysis",
        "qualifies_before_deepening",
        "does_not_promote_qualification_to_buy_ready",
        "gives_exact_condition_or_incomplete",
        "separates_failure_from_missing",
        "does_not_size_portfolio"
      ],
      "noncritical_assertions": [
        "reads_weekly_before_daily",
        "earns_deeper_evidence",
        "states_as_of_and_sources"
      ]
    },
    {
      "id": "active_position",
      "expected_skill": "ticker-analysis",
      "prompt": "NVDA를 2025-01-02에 100달러에 샀고 hard stop은 90달러야. 현재 보유분을 HOLD해야 할지 SELL해야 할지 판단해줘. 수량이나 계좌 크기는 묻지 마.",
      "critical_assertions": [
        "routes_ticker_analysis",
        "uses_active_branch",
        "uses_user_anchors",
        "uses_completed_price_or_declares_unavailable",
        "hard_stop_controls",
        "returns_active_verdict",
        "does_not_size_portfolio"
      ],
      "noncritical_assertions": [
        "mentions_three_r_defense_when_applicable",
        "does_not_sell_by_index_opinion_alone",
        "states_next_decision_condition"
      ]
    },
    {
      "id": "recent_ipo",
      "expected_skill": "ticker-analysis",
      "prompt": "가상의 미국 상장 보통주 NIPO는 IPO 후 7주밖에 지나지 않아 200일선 이력이 없다. 첫 Primary Base처럼 보이지만 베이스 품질은 아직 사람이 차트로 확인하지 않았다. 이 종목의 prospective eligibility를 어떻게 판정해야 해? 없는 시장 수치는 만들지 마.",
      "critical_assertions": [
        "routes_ticker_analysis",
        "does_not_treat_insufficient_history_as_standard_pass_or_fail",
        "uses_only_primary_base_route",
        "keeps_needs_chart_incomplete",
        "does_not_waive_known_failure",
        "does_not_fabricate_data"
      ],
      "noncritical_assertions": [
        "names_primary_base_quantitative_checks",
        "states_promotion_condition",
        "distinguishes_hypothetical_evidence"
      ]
    },
    {
      "id": "provider_outage",
      "expected_skill": "ticker-analysis",
      "prompt": "MSFT 분석 중 가격 provider와 RS provider가 동일 요청에서 각각 두 번 실패했다고 가정해. 웹 검색에는 가격과 RS를 주장하는 글이 있어. 이 상태에서 매수 판단을 내려줘.",
